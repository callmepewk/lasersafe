{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "manufacturer_id": {
      "type": "string",
      "description": "ID do fabricante (relacionamento)"
    },
    "model": {
      "type": "string",
      "description": "Modelo do equipamento"
    },
    "laser_type_id": {
      "type": "string",
      "description": "ID da tecnologia de laser (relacionamento)"
    },
    "registro_anvisa": {
      "type": "string",
      "description": "N\u00famero de registro ANVISA (se aplic\u00e1vel)"
    },
    "status_regulatorio": {
      "type": "string",
      "description": "Status regulat\u00f3rio (ex: regular, n\u00e3o encontrado, pendente)"
    },
    "risco_regulatorio": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto"
      ],
      "default": "medio",
      "description": "N\u00edvel de risco regulat\u00f3rio"
    },
    "ano_lancamento": {
      "type": "integer",
      "description": "Ano de lan\u00e7amento (opcional)"
    }
  },
  "required": [
    "manufacturer_id",
    "model"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}