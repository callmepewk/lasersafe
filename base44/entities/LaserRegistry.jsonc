{
  "name": "LaserRegistry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do equipamento ou tecnologia"
    },
    "registration": {
      "type": "string",
      "description": "N\u00famero de registro (se aplic\u00e1vel)"
    },
    "type": {
      "type": "string",
      "description": "Tipo (Equipamento ou Material, Refer\u00eancia t\u00e9cnica, etc.)"
    },
    "category": {
      "type": "string",
      "description": "Categoria regulat\u00f3ria/uso (m\u00e9dico, est\u00e9tico, dermatol\u00f3gico)"
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Principais aplica\u00e7\u00f5es dermatol\u00f3gicas"
    },
    "source": {
      "type": "string",
      "description": "Fonte de refer\u00eancia (ex: SBD, ANVISA)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}