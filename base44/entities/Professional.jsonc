{
  "name": "Professional",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do profissional"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do profissional"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do profissional"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade m\u00e9dica"
    },
    "license_number": {
      "type": "string",
      "description": "N\u00famero do registro profissional (CRM, etc.)"
    },
    "experience_years": {
      "type": "integer",
      "description": "Anos de experi\u00eancia"
    },
    "clinic_name": {
      "type": "string",
      "description": "Nome da cl\u00ednica onde trabalha"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "name",
    "cpf",
    "phone",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}