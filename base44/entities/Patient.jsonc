{
  "name": "Patient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do paciente"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do paciente"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "has_no_phone": {
      "type": "boolean",
      "default": false,
      "description": "Paciente n\u00e3o possui telefone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do paciente"
    },
    "has_no_email": {
      "type": "boolean",
      "default": false,
      "description": "Paciente n\u00e3o possui email"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "gender": {
      "type": "string",
      "enum": [
        "masculino",
        "feminino",
        "outro"
      ],
      "description": "G\u00eanero do paciente"
    },
    "phototype": {
      "type": "string",
      "enum": [
        "I",
        "II",
        "III",
        "IV",
        "V",
        "VI"
      ],
      "description": "Fototipo de Fitzpatrick"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "muito_clara",
        "clara",
        "clara_media",
        "media",
        "morena_clara",
        "morena",
        "morena_escura",
        "negra_clara",
        "negra",
        "negra_escura"
      ],
      "description": "Tonalidade da pele"
    },
    "ethnic_identity": {
      "type": "string",
      "enum": [
        "branco",
        "preto",
        "pardo",
        "amarelo",
        "indigena_tupi",
        "indigena_guarani",
        "indigena_yanomami",
        "indigena_outros",
        "outro"
      ],
      "description": "Identifica\u00e7\u00e3o \u00e9tnica do paciente"
    },
    "skin_sensitivity": {
      "type": "string",
      "enum": [
        "muito_sens\u00edvel",
        "sens\u00edvel",
        "normal",
        "resistente"
      ],
      "description": "Sensibilidade da pele"
    },
    "glogau_scale": {
      "type": "string",
      "description": "Escala de Glogau"
    },
    "acne_scar_classification": {
      "type": "string",
      "description": "Classifica\u00e7\u00e3o de Cicatrizes de Acne"
    },
    "leeds_acne_scale": {
      "type": "string",
      "description": "Escala de Acne (Leeds)"
    },
    "medical_history": {
      "type": "string",
      "description": "Hist\u00f3rico m\u00e9dico do paciente"
    },
    "medications": {
      "type": "string",
      "description": "Medica\u00e7\u00f5es em uso"
    },
    "allergies": {
      "type": "string",
      "description": "Alergias conhecidas"
    }
  },
  "required": [
    "name",
    "cpf"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}