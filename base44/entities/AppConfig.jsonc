{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o"
    },
    "value": {
      "type": "string",
      "description": "Valor da configura\u00e7\u00e3o (pode ser JSON stringificado)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da configura\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature_flag",
        "version",
        "config",
        "scheduled_update"
      ],
      "description": "Tipo de configura\u00e7\u00e3o"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Se a configura\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "key",
    "value",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {},
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}